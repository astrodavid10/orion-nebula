        <Place MSRCommunityId="0" MSRComponentId="0" Permission="0" Thumbnail="http://data1.wwtassets.org/feeds/eso/eso1723a/thumb.jpg" Name="ESO/VST - Optical" DataSetType="Sky" RA="5.5856248626045861" Dec="-5.4786707566698025" Constellation="ORI" Classification="Unidentified" Magnitude="0" Distance="0" ZoomLevel="7.91538558418722" Rotation="0" Angle="0" DomeAlt="0" DomeAz="0" Opacity="100" AngularSize="7.91538558418722">
            <Description>OmegaCAM — the wide-field optical camera on ESO’s VLT Survey Telescope (VST) — has captured the spectacular Orion Nebula and its 
                associated cluster of young stars in great detail,  producing this beautiful new image. This famous object, the birthplace of many massive stars, 
                is one of the closest stellar nurseries, at a distance of about 1350 light-years.
            </Description>
            <Target>Undefined</Target>
            <ForegroundImageSet>
