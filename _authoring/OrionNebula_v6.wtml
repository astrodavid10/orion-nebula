        <Place MSRCommunityId="0" MSRComponentId="0" Permission="0" Thumbnail="http://data1.wwtassets.org/feeds/eso/eso1625a/thumb.jpg" Name="HAWK-I - Infrared" DataSetType="Sky" RA="5.5879371026376923" Dec="-5.3387740086782092" Constellation="ORI" Classification="Unidentified" Magnitude="0" Distance="0" ZoomLevel="3.7517026905339019" Rotation="0" Angle="0" DomeAlt="0" DomeAz="0" Opacity="100" AngularSize="3.7517026905339019">
            <Description>This spectacular image of the Orion Nebula star-formation region was obtained from multiple exposures using the HAWK-I infrared camera on ESO’s 
                Very Large Telescope in Chile. This is the deepest view ever of this region and reveals more very faint planetary-mass objects than expected.
            </Description>
            <ForegroundImageSet>
            <ImageSet MSRCommunityId="0" MSRComponentId="0" Permission="0" Generic="False" DataSetType="Sky" BandPass="Visible" Url="http://data1.wwtassets.org/feeds/eso/eso1625a/L{1}X{2}Y{3}.png" TileLevels="6" WidthFactor="2" Sparse="True" Rotation="-90.06" QuadTreeMap="" Projection="Tangent" Name="A deep infrared view of the Orion Nebula from HAWK-I" FileType=".png" CenterY="-5.3387591763" CenterX="83.8190714054" BottomsUp="False" StockSet="False" ElevationModel="False" OffsetX="1.48168703379E-05" OffsetY="1.48168703379E-05" BaseTileLevel="0" BaseDegreesPerTile="0.48551920723230718" MeanRadius="0">
