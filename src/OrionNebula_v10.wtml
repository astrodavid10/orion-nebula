  <Place Angle="0" AngularSize="33.9283333333333" Classification="Nebula" Constellation="ORI" DataSetType="Sky" Dec="-5.34361111111111" Magnitude="0" Name="Don McCrady - RGB/H-alpha" Opacity="100" RA="5.586111111111109" Rotation="0" ZoomLevel="33.9283333333333">
    <Description>The Great Orion Nebula (M42) is a true showpiece in the night sky. It is easily visible to the naked eye as a fuzzy 
                patch in the sword of Orion, and is a beautiful sight in telescopes of all sizes. It lies fairly close to our part of the galaxy, 
                lying some 1500 light years distant. The center portion contains a tight grouping of stars called the Trapezium. M43 lies just above 
                the Trapezium region, and another bright reflection nebula called The Running Man Nebula is near the top of this frame. This image 
                is a blend of RGB data with Hydrogen-Alpha data. The RGB was blended with the H-alpha to form an artificial luminance layer, and the 
                H-alpha was blended into the red channel of the colour layer.
            </Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="2.13195253505933" BaseTileLevel="0" BottomsUp="False" CenterX="83.79335576398091" CenterY="-5.342150949749448" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="Great Nebula in Orion" Projection="Tan" QuadTreeMap="" Rotation="0.52" Sparse="True" StockSet="False" TileLevels="3" Url="http://www.worldwidetelescope.org/wwtweb/tiles.aspx?q={1},{2},{3},843190889" WidthFactor="2">
        <Credits>Don J. McCrady</Credits>
        <CreditsUrl>http://www.flickr.com/photos/djmccrady/2221024093/</CreditsUrl>
        <ThumbnailUrl>http://www.worldwidetelescope.org/wwtweb/thumbnail.aspx?name=843190889</ThumbnailUrl>
      </ImageSet>
    </ForegroundImageSet>
  </Place>
  <Place Angle="0" AngularSize="174.232053577738" DataSetType="Sky" Dec="-0.128822370036991" Magnitude="0" Name="Matt Harbison - HA-LRGB" Opacity="100" RA="5.6218844822333125" Rotation="0" Thumbnail="http://data1.wwtassets.org/packages/2022/04_orion_harbison/7_year_orion/thumb.jpg" ZoomLevel="174.232053577738">
	<Description>
		The Orion Constellation Captured by Matt Harbison

Captured over 7 years across the Southern US and Marathon Texas. Over 200 individual panels consisting of 12,816 Individual light frames. </Description>
    <ForegroundImageSet>
      <ImageSet BandPass="Visible" BaseDegreesPerTile="29.206051740085766" BaseTileLevel="0" BottomsUp="False" CenterX="84.73106743929381" CenterY="0.39947787331717655" DataSetType="Sky" ElevationModel="False" FileType=".png" Generic="False" Name="7 Year Orion by Matt Harbison" Projection="Tan" QuadTreeMap="" Rotation="-69.92000000000006" Sparse="True" StockSet="False" TileLevels="8" Url="http://data1.wwtassets.org/packages/2022/04_orion_harbison/7_year_orion/{1}/{3}/{3}_{2}.png" WidthFactor="2">
